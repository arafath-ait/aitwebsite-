<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AIT - Advanced Information Technology</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            /* സൂപ്പർ കളർഫുൾ ഗ്രേഡിയന്റ് ബാക്ക്ഗ്രൗണ്ട് */
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #311042 100%);
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 20px;
            overflow-y: auto;
        }

        .main-card {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 30px;
            width: 100%;
            max-width: 600px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
            margin-top: 10px;
            margin-bottom: 30px;
        }

        .header {
            text-align: center;
            margin-bottom: 25px;
        }

        .brand-logo {
            font-size: 38px;
            font-weight: 900;
            letter-spacing: 3px;
            background: linear-gradient(to right, #38bdf8, #818cf8, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .sub-title {
            color: #94a3b8;
            font-size: 14px;
            margin-top: 5px;
            font-weight: 600;
        }

        .btn-ait {
            width: 100%;
            padding: 16px;
            background: linear-gradient(90deg, #2563eb, #7c3aed);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s ease;
            box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
        }

        .btn-ait:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(124, 58, 237, 0.6);
        }

        .login-box {
            display: none;
            margin-top: 20px;
            background: #020617;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #334155;
        }

        input, textarea {
            width: 100%;
            padding: 12px;
            margin-bottom: 12px;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 8px;
            color: white;
            font-size: 14px;
        }

        input:focus, textarea:focus {
            outline: none;
            border-color: #38bdf8;
        }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background: linear-gradient(90deg, #10b981, #059669);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            font-size: 15px;
        }

        .admin-panel {
            display: none;
            margin-top: 25px;
        }

        .section-title {
            font-size: 16px;
            color: #38bdf8;
            margin-bottom: 12px;
            border-bottom: 1px solid #334155;
            padding-bottom: 6px;
            font-weight: 700;
        }

        /* ടീം വിവരങ്ങൾ */
        .member-card {
            background: #020617;
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 4px solid #c084fc;
        }

        .member-code {
            background: #1e1b4b;
            padding: 4px 10px;
            border-radius: 6px;
            font-family: monospace;
            color: #38bdf8;
            font-size: 13px;
            font-weight: bold;
        }

        /* PDF ലുക്കിലുള്ള സ്ക്രോളിംഗ് സപ്പോർട്ട് */
        .content-scroll-area {
            max-height: 380px;
            overflow-y: auto;
            padding-right: 5px;
        }

        .content-scroll-area::-webkit-scrollbar {
            width: 6px;
        }
        .content-scroll-area::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 10px;
        }

        .link-card {
            background: #020617;
            padding: 14px;
            border-radius: 10px;
            margin-bottom: 10px;
            border-left: 4px solid #38bdf8;
        }

        .link-card a {
            color: #38bdf8;
            text-decoration: none;
            font-weight: bold;
            font-size: 15px;
            word-break: break-all;
        }

        .note-card {
            background: #020617;
            padding: 14px;
            border-radius: 10px;
            margin-bottom: 10px;
            border-left: 4px solid #f59e0b;
            color: #e2e8f0;
            font-size: 14px;
            white-space: pre-wrap;
            line-height: 1.5;
        }

        .error-msg {
            color: #f43f5e;
            font-size: 14px;
            margin-top: 8px;
            text-align: center;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="main-card">
        <div class="header">
            <div class="brand-logo">AIT</div>
            <div class="sub-title">Arafath Information Technology • Corporate Portal</div>
        </div>

        <!-- AIT ബട്ടൺ -->
        <button class="btn-ait" onclick="toggleLogin()">🔒 AIT Control Center</button>

        <!-- പാസ്‌വേഡ് ബോക്സ് -->
        <div id="loginBox" class="login-box">
            <input type="password" id="passInput" placeholder="Enter Security Access Key">
            <button class="btn-submit" onclick="verifyPass()">Verify Passcode</button>
            <div id="errMsg" class="error-msg"></div>
        </div>

        <!-- അഡ്മിൻ പാനൽ -->
        <div id="adminPanel" class="admin-panel">
            
            <!-- 1. അംഗങ്ങളും കോഡുകളും -->
            <div class="section-title">👥 Authorized Members & Security Codes</div>
            <div class="member-card">
                <span>AIT Lead Engineer</span>
                <span class="member-code">CODE: AIT-101</span>
            </div>
            <div class="member-card">
                <span>AIT System Admin</span>
                <span class="member-code">CODE: AIT-102</span>
            </div>
            <div class="member-card">
                <span>AIT Technical Manager</span>
                <span class="member-code">CODE: AIT-103</span>
            </div>

            <!-- 2. ലിങ്കുകളും പ്ലാനുകളും ചേർക്കാനുള്ള ഫോം -->
            <div class="section-title" style="margin-top: 25px;">⚙️ Add / Change Portal Resources</div>
            <div style="background: #020617; padding: 15px; border-radius: 10px; margin-bottom: 20px;">
                <input type="text" id="linkName" placeholder="Link Name (e.g., Main YouTube Channel)">
                <input type="text" id="linkUrl" placeholder="Link URL (e.g., https://...)">
                <textarea id="planNote" rows="3" placeholder="Write Future Plans / Notes here..."></textarea>
                <button class="btn-submit" onclick="addNewContent()">+ Save to System</button>
            </div>

            <!-- 3. താഴേക്ക് സ്ക്രോൾ ചെയ്യാവുന്ന ലിങ്കുകളും നോട്ടുകളും -->
            <div class="section-title">📂 Saved Resources & Future Plans</div>
            <div class="content-scroll-area" id="displayArea">
                
                <div class="link-card">
                    <div style="font-size: 12px; color: #94a3b8; margin-bottom: 4px;">Official Resource</div>
                    <a href="https://youtube.com" target="_blank">AIT YouTube Channel</a>
                </div>

                <div class="note-card">
                    <strong>📌 Project Note:</strong> AIT സിസ്റ്റം കൂടുതൽ ഉയർന്ന അഡ്വാൻസ്ഡ് ഫീച്ചറുകളോടെ അപ്‌ഗ്രേഡ് ചെയ്യുക.
                </div>

            </div>

        </div>
    </div>

    <script>
        // വെബ്‌സൈറ്റിന്റെ അക്സസ്സ് പാസ്‌വേഡ്
        const AIT_PASSWORD = "123";

        function toggleLogin() {
            var box = document.getElementById("loginBox");
            box.style.display = box.style.display === "block" ? "none" : "block";
        }

        function verifyPass() {
            var input = document.getElementById("passInput").value;
            var err = document.getElementById("errMsg");
            var panel = document.getElementById("adminPanel");
            var loginBox = document.getElementById("loginBox");

            if(input === AIT_PASSWORD) {
                loginBox.style.display = "none";
                panel.style.display = "block";
                err.innerHTML = "";
            } else {
                err.innerHTML = "❌ Invalid Security Access Passcode!";
            }
        }

        function addNewContent() {
            var name = document.getElementById("linkName").value;
            var url = document.getElementById("linkUrl").value;
            var note = document.getElementById("planNote").value;
            var display = document.getElementById("displayArea");

            if(name && url) {
                var linkHTML = `
                    <div class="link-card">
                        <div style="font-size: 12px; color: #94a3b8; margin-bottom: 4px;">Added Resource</div>
                        <a href="${url}" target="_blank">${name}</a>
                    </div>
                `;
                display.innerHTML = linkHTML + display.innerHTML;
            }

            if(note) {
                var noteHTML = `
                    <div class="note-card">
                        <strong>📌 Plan / Note:</strong> ${note}
                    </div>
                `;
                display.innerHTML = noteHTML + display.innerHTML;
            }

            document.getElementById("linkName").value = "";
            document.getElementById("linkUrl").value = "";
            document.getElementById("planNote").value = "";
        }
    </script>

</body>
</html>

        <!-- ================= 2. നോട്ട് ഓപ്ഷൻ വിൻഡോ (ടൈംടേബിൾ സിസ്റ്റം) ================= -->
        <div id="note-section" style="display: none;">
            <!-- ഫയൽ നെയിം സെറ്റപ്പ് ബോക്സ് -->
            <div id="file-setup" style="background: #22222e; padding: 20px; border-radius: 12px; margin-bottom: 20px; border: 1px solid #333344;">
                <p style="margin-bottom: 12px; font-weight: bold; color: #ff0055;">ഫയലിന്റെ / ടൈംടേബിളിന്റെ പേര് നൽകുക:</p>
                <input type="text" id="noteFileName" value="എന്റെ പുതിയ ടൈംടേബിൾ" style="margin-bottom: 15px;">
                <button class="btn-success" onclick="initNoteWorkspace()" style="padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer;">✓ പേജ് തുറക്കൂ (Done)</button>
            </div>

            <!-- ടൈംടേബിൾ ടൂൾബാർ -->
            <div class="note-toolbar" id="noteToolbar" style="display: none;">
                <label style="font-size: 13px; font-weight: bold; color: #aaa;">എഴുത്ത് ശൈലി:</label>
                <select id="noteStyleSelect" onchange="applyNoteColor()" style="width: auto; padding: 6px 10px;">
                    <option value="normal">സാധാരണ ശൈലി</option>
                    <option value="col-rainbow">🌈 റെയിൻബോ ഫീച്ചർ</option>
                    <option value="col-fire">🔥 ഫയർ ഇഫക്റ്റ്</option>
                    <option value="col-ocean">🌊 ഓഷ്യൻ ഇഫക്റ്റ്</option>
                </select>

                <label style="font-size: 13px; font-weight: bold; color: #aaa; margin-left: 10px;">വലിപ്പം:</label>
                <input type="range" id="fontSizeSlider" min="16" max="100" value="22" oninput="changeFontSize()" style="cursor: pointer; vertical-align: middle;">
                <span id="fontSizeVal" style="font-size: 13px; font-weight: bold; color: #ff0055;">22px</span>

                <span style="border-left: 2px solid #444; height: 20px; margin: 0 10px;"></span>

                <label style="font-size: 13px; font-weight: bold; color: #aaa;">📊 കള്ളികൾ:</label>
                <input type="number" id="tblCols" value="5" min="1" max="10" style="width: 50px; padding: 5px; text-align: center; background: #181820; color: white; border: 1px solid #444; border-radius: 5px;">
                <input type="number" id="tblRows" value="4" min="1" max="12" style="width: 50px; padding: 5px; text-align: center; background: #181820; color: white; border: 1px solid #444; border-radius: 5px; margin-left: 4px;">
                <button class="ctrl-btn" onclick="addTable()" style="padding: 6px 12px; font-size: 13px; margin-left: 5px;">+ ചേർക്കൂ</button>

                <button class="btn-pdf" onclick="downloadPDF()" style="padding: 8px 15px; font-size: 14px; margin-left: auto;">📥 PDF ആക്കുക</button>
            </div>

            <!-- വർക്കിംഗ് ഷീറ്റ് -->
            <div class="note-workspace" id="noteWorkspace" style="display: none;">
                <div id="fileLabelDisplay" style="font-size: 12px; color: #777; margin-bottom: 10px; border-bottom: 1px dashed #ddd; padding-bottom: 5px;">ഫയൽ: </div>
                <input type="text" id="note-main-heading" value="തലക്കെട്ട് ഇവിടെ നൽകുക..." placeholder="തലക്കെട്ട്...">
                <div id="note-main-body" contenteditable="true">ഇവിടെ ടൈപ്പ് ചെയ്യുക... ടൈംടേബിൾ ടേബിളുകൾ ആവശ്യമെങ്കിൽ മുകളിലെ കള്ളികളുടെ എണ്ണം നൽകി ചേർക്കാവുന്നതാണ്.</div>
            </div>
        </div>
    </div>

    <script>
        // 📈 വിസിറ്റർ കൗണ്ട് ട്രാക്കിംഗ്
        let count = localStorage.getItem('png_page_view');
        if (count === null) { count = 1; } else { count = parseInt(count) + 1; }
        localStorage.setItem('png_page_view', count);

        // 🔒 രഹസ്യ AIT പാസ്സ്‌വേർഡ് ഫങ്ക്ഷൻ
        function checkVisitorCount() {
            let password = prompt("ENTER SECRET CODE:");
            if (password === "AIT 2012") {
                alert("📊 ആകെ വിസിറ്റേഴ്സ്: " + count + " പേർ");
            } else if (password !== null) {
                alert("❌ ACCESS DENIED!");
            }
        }

        // 🗂️ ടാബുകൾ മാറാനുള്ള ഫങ്ക്ഷൻ
        function switchTab(tabName) {
            if(tabName === 'text') {
                document.getElementById('text-section').style.display = 'block';
                document.getElementById('note-section').style.display = 'none';
                document.getElementById('tab-text').classList.add('active');
                document.getElementById('tab-note').classList.remove('active');
            } else {
                document.getElementById('text-section').style.display = 'none';
                document.getElementById('note-section').style.display = 'block';
                document.getElementById('tab-note').classList.add('active');
                document.getElementById('tab-text').classList.remove('active');
            }
        }

        // ================= 1. ടെക്സ്റ്റ് ഓപ്ഷൻ ലോജിക്കുകൾ =================
        function updateStyle() {
            let input = document.getElementById("inputText").value;
            let target = document.getElementById("captureTarget");
            let selectedStyle = document.getElementById("styleSelect").value;
            
            if (input.trim() === "") {
                target.innerText = "Type Something...";
                return;
            }
            
            target.className = ""; 
            target.classList.add(selectedStyle);
            target.innerText = input;
        }

        document.getElementById("inputText").addEventListener("input", updateStyle);

        function downloadPNG() {
            let target = document.getElementById("captureTarget");
            let filename = document.getElementById("inputText").value.trim() || "style";
            
            html2canvas(target, {
                backgroundColor: null, 
                scale: 3 
            }).then(canvas => {
                let image = canvas.toDataURL("image/png");
                let link = document.createElement('a');
                link.download = filename + '_style.png';
                link.href = image;
                link.click();
            });
        }

        // ================= 2. നോട്ട് ഓപ്ഷൻ (ടൈംടേബിൾ) ലോജിക്കുകൾ =================
        let activeFileName = "Timetable";

        function initNoteWorkspace() {
            let nameInput = document.getElementById('noteFileName').value.trim();
            if(nameInput !== "") {
                activeFileName = nameInput;
                document.getElementById('fileLabelDisplay').innerText = "📄 ഫയൽ നാമം: " + activeFileName;
                document.getElementById('file-setup').style.display = 'none';
                document.getElementById('noteToolbar').style.display = 'flex';
                document.getElementById('noteWorkspace').style.display = 'block';
            }
        }

        function applyNoteColor() {
            let selectedColor = document.getElementById('noteStyleSelect').value;
            let bodyArea = document.getElementById('note-main-body');
            bodyArea.classList.remove('col-rainbow', 'col-fire', 'col-ocean');
            if(selectedColor !== 'normal') {
                bodyArea.classList.add(selectedColor);
            }
        }

        function changeFontSize() {
            let size = document.getElementById('fontSizeSlider').value;
            document.getElementById('fontSizeVal').innerText = size + "px";
            document.getElementById('note-main-body').style.fontSize = size + "px";
        }

        function addTable() {
            let cols = document.getElementById('tblCols').value;
            let rows = document.getElementById('tblRows').value;
            let bodyArea = document.getElementById('note-main-body');

            let tableHTML = '<table contenteditable="true"><thead><tr>';
            for(let c = 0; c < cols; c++) {
                tableHTML += `<th>കള്ളി ${c+1}</th>`;
            }
            tableHTML += '</tr></thead><tbody>';
            
            for(let r = 0; r < rows - 1; r++) {
                tableHTML += '<tr>';
                for(let c = 0; c < cols; c++) {
                    tableHTML += '<td></td>';
                }
                tableHTML += '</tr>';
            }
            tableHTML += '</tbody></table><br>';
            bodyArea.innerHTML += tableHTML;
        }

        // സൂപ്പർ ഹൈ-ക്വാളിറ്റി PDF എക്സ്പോർട്ട് ഫങ്ക്ഷൻ
        function downloadPDF() {
            let element = document.getElementById('noteWorkspace');
            let opt = {
                margin:       15,
                filename:     activeFileName + '.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
        
        // തുടക്കത്തിൽ ഫങ്ക്ഷൻ ലോഡ് ചെയ്യാൻ
        updateStyle();
    </script>
</body>
</html>

    <script>
        let currentMode = 'text';

        function switchTab(mode) {
            currentMode = mode;
            if(mode === 'text') {
                document.getElementById('text-section').style.display = 'block';
                document.getElementById('anim-section').style.display = 'none';
                document.getElementById('tab-text').classList.add('active');
                document.getElementById('tab-anim').classList.remove('active');
                updateStyle();
            } else {
                document.getElementById('text-section').style.display = 'none';
                document.getElementById('anim-section').style.display = 'block';
                document.getElementById('tab-anim').classList.add('active');
                document.getElementById('tab-text').classList.remove('active');
                updateAnim();
            }
        }

        function updateStyle() {
            let input = document.getElementById("inputText").value.trim() || "ഇവിടെ ടൈപ്പ് ചെയ്യൂ...";
            let target = document.getElementById("captureTarget");
            target.className = document.getElementById("styleSelect").value;
            target.innerText = input;
        }

        function updateAnim() {
            let input = document.getElementById("inputText").value.trim() || "ഇവിടെ ടൈപ്പ് ചെയ്യൂ...";
            let target = document.getElementById("captureTarget");
            target.className = document.getElementById("animSelect").value;
            target.innerText = input;
        }

        document.getElementById("inputText").addEventListener("input", () => {
            if(currentMode === 'text') updateStyle();
            else updateAnim();
        });

        // 📥 Transparent PNG സേവ് ചെയ്യൻ
        function downloadPNG() {
            let target = document.getElementById("captureTarget");
            let filename = document.getElementById("inputText").value.trim() || "style";
            
            html2canvas(target, {
                backgroundColor: null,
                scale: 3
            }).then(canvas => {
                let link = document.createElement('a');
                link.download = filename + '_transparent.png';
                link.href = canvas.toDataURL("image/png");
                link.click();
            });
        }

        // 🎬 Transparent GIF/Animation
        function downloadTransparentGIF() {
            alert("ആനിമേഷൻ സുതാര്യമായി (Transparent) സേവ് ചെയ്യുന്നു...");

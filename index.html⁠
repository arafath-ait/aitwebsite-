                    <option value="st-60">🔮 60. Cyber Magenta</option>
                    <!-- ഗ്രൂപ്പ് 61 - 70 -->
                    <option value="st-61">🛸 61. Alien Slime</option>
                    <option value="st-62">🎙️ 62. Metallic Grey</option>
                    <option value="st-63">🎨 63. Yellow Chalk</option>
                    <option value="st-64">⚡ 64. Electro Green</option>
                    <option value="st-65">🍇 65. Violet Wave</option>
                    <option value="st-66">🌋 66. Lava Rock</option>
                    <option value="st-67">💡 67. Yellow Laser</option>
                    <option value="st-68">📟 68. Digital Glitch</option>
                    <option value="st-69">🧨 69. Hacker Red</option>
                    <option value="st-70">👾 70. Arcade Purple</option>
                    <!-- 🌟 പുതിയ ഗ്രൂപ്പ് 71 - 80 🌟 -->
                    <option value="st-71">🌶️ 71. Spice Blast</option>
                    <option value="st-72">📐 72. Isometric 3D</option>
                    <option value="st-73">💥 73. Burning Fire</option>
                    <option value="st-74">👺 74. Demon Soul</option>
                    <option value="st-75">🎏 75. Samurai Blade</option>
                    <option value="st-76">📦 76. Paper Fold</option>
